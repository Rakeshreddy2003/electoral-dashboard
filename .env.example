# Copy to .env and fill in. Never commit the real .env file.

POSTGRES_PASSWORD=change-me

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

ODK_BASE_URL=https://your-odk-central-host.example
ODK_EMAIL=dashboard-sync@crawindia.com
ODK_PASSWORD=change-me
ODK_PROJECT_ID=1
ODK_FORM_ID=na_livelihoods_survey_v4
ODK_SYNC_INTERVAL_MINUTES=20

# Set false to pause pulling from ODK Central entirely (API still serves
# whatever's already in Postgres). true/unset resumes live syncing.
ODK_SYNC_ENABLED=true

# Temporary dev-only toggle: skips login and role checks, every request is
# treated as admin. Leave false/unset in any deployment with real data.
AUTH_DISABLED=false
